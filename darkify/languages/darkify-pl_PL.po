#: src/Admin/Views/AdvancedSettings.php:88
msgid "Disallowed Elements"
msgstr "Wykluczone elementy"

#: src/Admin/Views/AdvancedSettings.php:91
msgid "Dark mode will NOT be applied to the elements."
msgstr "Tryb ciemny NIE zostanie zastosowany do tych elementów."

#: src/Admin/Views/AdvancedSettings.php:104
msgid "Force To Correct"
msgstr "Wymuś korektę"

#: src/Admin/Views/AdvancedSettings.php:106
msgid "Force Darkify to keep the design correct when background or text colors do not work properly for disallowed elements."
msgstr "Wymuś na Darkify poprawny wygląd, gdy kolory tła lub tekstu nie działają prawidłowo w wykluczonych elementach."

#: src/Admin/Views/AdvancedSettings.php:118
msgid "Page/Posts Restriction"
msgstr "Ograniczenia stron i wpisów"

#: src/Admin/Views/AdvancedSettings.php:124
msgid "Limit where dark mode and the floating switch run, by specific pages or posts."
msgstr "Ogranicz miejsca działania trybu ciemnego i pływającego przełącznika do wybranych stron lub wpisów."

#: src/Admin/Views/AdvancedSettings.php:128
msgid "Pages Restriction"
msgstr "Ograniczenia stron"

#: src/Admin/Views/AdvancedSettings.php:134
msgid "Allow Only Pages"
msgstr "Dozwolone tylko strony"

#: src/Admin/Views/AdvancedSettings.php:137
msgid "Dark mode will be applied only to the selected pages."
msgstr "Tryb ciemny zostanie zastosowany wyłącznie do wybranych stron."

#: src/Admin/Views/AdvancedSettings.php:139
msgid "Choose only the pages where dark mode and the floating switch should work. Dark mode will not be applied to any other pages."
msgstr "Wybierz tylko te strony, na których mają działać tryb ciemny i pływający przełącznik. Na pozostałych stronach tryb ciemny nie zostanie zastosowany."

#: src/Admin/Views/AdvancedSettings.php:141
#: src/Admin/Views/AdvancedSettings.php:161
msgid "Select pages"
msgstr "Wybierz strony"

#: src/Admin/Views/AdvancedSettings.php:152
#: src/Admin/Views/Control.php:307
msgid "Disallowed Pages"
msgstr "Wykluczone strony"

#: src/Admin/Views/AdvancedSettings.php:155
msgid "Dark mode will not be applied to these pages."
msgstr "Tryb ciemny nie zostanie zastosowany do tych stron."

#: src/Admin/Views/AdvancedSettings.php:157
msgid "Choose the pages where dark mode and the floating switch should not work. Dark mode will work on all other pages."
msgstr "Wybierz strony, na których tryb ciemny i pływający przełącznik nie mają działać. Na wszystkich pozostałych stronach tryb ciemny będzie działać."

#: src/Admin/Views/AdvancedSettings.php:170
msgid "Posts Restriction"
msgstr "Ograniczenia wpisów"

#: src/Admin/Views/AdvancedSettings.php:176
msgid "Allow Only Posts"
msgstr "Dozwolone tylko wpisy"

#: src/Admin/Views/AdvancedSettings.php:179
msgid "Dark mode will be applied only to these posts."
msgstr "Tryb ciemny zostanie zastosowany wyłącznie do tych wpisów."

#: src/Admin/Views/AdvancedSettings.php:181
msgid "Choose only the posts where dark mode and the floating switch should work. Dark mode will not be applied to any other posts."
msgstr "Wybierz tylko te wpisy, w których mają działać tryb ciemny i pływający przełącznik. W pozostałych wpisach tryb ciemny nie zostanie zastosowany."

#: src/Admin/Views/AdvancedSettings.php:184
#: src/Admin/Views/AdvancedSettings.php:200
msgid "Select posts"
msgstr "Wybierz wpisy"

#: src/Admin/Views/AdvancedSettings.php:193
msgid "Disallowed Posts"
msgstr "Wykluczone wpisy"

#: src/Admin/Views/AdvancedSettings.php:196
msgid "Dark mode will not be applied to these posts."
msgstr "Tryb ciemny nie zostanie zastosowany do tych wpisów."

#: src/Admin/Views/AdvancedSettings.php:198
msgid "Choose the posts where dark mode and the floating switch cannot work. Other posts will be able to process dark mode."
msgstr "Wybierz wpisy, w których tryb ciemny i pływający przełącznik nie mogą działać. W pozostałych wpisach tryb ciemny będzie obsługiwany."

#: src/Admin/Views/AdvancedSettings.php:210
#: src/Admin/Views/AdvancedSettings.php:221
msgid "Custom CSS"
msgstr "Własny CSS"

#: src/Admin/Views/AdvancedSettings.php:216
msgid "Add your own CSS for dark mode, and CSS that applies in both modes."
msgstr "Dodaj własny kod CSS dla trybu ciemnego oraz CSS stosowany w obu trybach."

#: src/Admin/Views/AdvancedSettings.php:227
msgid "Dark Mode CSS"
msgstr "CSS trybu ciemnego"

#: src/Admin/Views/AdvancedSettings.php:230
msgid "The CSS code will only be applied when dark mode is active."
msgstr "Kod CSS zostanie zastosowany tylko wtedy, gdy tryb ciemny jest aktywny."

#: src/Admin/Views/AdvancedSettings.php:241
msgid "CSS Rules"
msgstr "Reguły CSS"

#: src/Admin/Views/AdvancedSettings.php:245
msgid "CSS rules will be applied to all child elements of the specified CSS selectors."
msgstr "Reguły CSS zostaną zastosowane do wszystkich elementów podrzędnych wskazanych selektorów CSS."

#: src/Admin/Views/AdvancedSettings.php:248
msgid "Custom CSS selectors are automatically treated as Disallowed Elements. To override this behavior, use the :not-disallowed pseudo-class. Example: body:not-disallowed { ... }"
msgstr "Własne selektory CSS są automatycznie traktowane jako wykluczone elementy. Aby to zmienić, użyj pseudoklasy :not-disallowed. Przykład: body:not-disallowed { ... }"

#: src/Admin/Views/AdvancedSettings.php:261
msgid "Normal Mode CSS"
msgstr "CSS trybu normalnego"

#: src/Admin/Views/AdvancedSettings.php:264
msgid "The CSS code will be applied in both normal mode and dark mode."
msgstr "Kod CSS zostanie zastosowany zarówno w trybie normalnym, jak i ciemnym."

#: src/Admin/Views/AdvancedSettings.php:282
#: src/Admin/Views/AdvancedSettings.php:293
msgid "Extras"
msgstr "Dodatki"

#: src/Admin/Views/AdvancedSettings.php:288
msgid "Extra behaviors that don’t fit elsewhere."
msgstr "Dodatkowe zachowania, które nie pasują do pozostałych sekcji."

#: src/Admin/Views/AdvancedSettings.php:299
msgid "Frontend Iframe Dark Mode"
msgstr "Tryb ciemny dla ramek iframe na stronie"

#: src/Admin/Views/AdvancedSettings.php:302
msgid "Apply dark mode to iframes when dark mode is active. Same-origin iframes receive full dark mode styling; cross-origin iframes (embedded third-party widgets) are dimmed to 60% brightness. Disable to keep all iframes at their original appearance."
msgstr "Stosuj tryb ciemny do ramek iframe, gdy tryb ciemny jest aktywny. Ramki z tej samej domeny otrzymują pełne stylowanie trybu ciemnego; ramki z innych domen (osadzone widżety zewnętrzne) są przyciemniane do 60% jasności. Wyłącz, aby zachować pierwotny wygląd wszystkich ramek."

