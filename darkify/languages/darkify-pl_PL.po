msgid "Advanced"
msgstr "Zaawansowane"

#: src/Admin/Views/AdvancedSettings.php:36
#: src/Admin/Views/AdvancedSettings.php:47
msgid "HTML/CSS Restriction"
msgstr "Ograniczenia HTML/CSS"

#: src/Admin/Views/AdvancedSettings.php:42
msgid "Restrict which HTML elements dark mode applies to, by tag, CSS class, or CSS ID."
msgstr "Ogranicz, do których elementów HTML stosowany jest tryb ciemny — według znacznika, klasy CSS lub identyfikatora CSS."

#: src/Admin/Views/AdvancedSettings.php:54
msgid "Allow Only Elements"
msgstr "Dozwolone tylko elementy"

#: src/Admin/Views/AdvancedSettings.php:57
msgid "Dark mode will be applied only to these elements."
msgstr "Tryb ciemny zostanie zastosowany wyłącznie do tych elementów."

#: src/Admin/Views/AdvancedSettings.php:59
#: src/Admin/Views/AdvancedSettings.php:94
msgid "Enter comma-separated HTML tags, CSS classes, or CSS IDs. Example: div, #site-header, .my-footer"
msgstr "Wpisz znaczniki HTML, klasy CSS lub identyfikatory CSS oddzielone przecinkami. Przykład: div, #site-header, .my-footer"

#: src/Admin/Views/AdvancedSettings.php:71
msgid "Force Design Correction"
msgstr "Wymuś korektę wyglądu"

#: src/Admin/Views/AdvancedSettings.php:74
msgid "Force Darkify to preserve layout and readability when background or text colors are modified on allowed elements."
msgstr "Wymuś na Darkify zachowanie układu i czytelności, gdy kolory tła lub tekstu są zmieniane w dozwolonych elementach."

